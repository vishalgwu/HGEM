{
  "name": "@guardmem/sdk",
  "version": "0.0.1",
  "description": "GuardMem AI SDK for TypeScript — dashboard client + edge-agent helpers.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/client.ts",
  "types": "./src/types.ts",
  "exports": {
    ".": "./src/client.ts",
    "./react": "./src/react/useMemory.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.5"
  }
}
