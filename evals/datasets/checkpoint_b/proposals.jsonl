{"namespace": "patient:9001", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "Morning. I'm updating your record before the appointment - a few questions.", "captured_at": "2026-02-03T09:15:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "Go ahead, though I've only got ten minutes.", "captured_at": "2026-02-03T09:15:00+00:00"}, {"turn_id": "t03", "role": "assistant", "text": "Any drug allergies?", "captured_at": "2026-02-03T09:15:00+00:00"}, {"turn_id": "t04", "role": "user", "text": "Penicillin. I came out in hives as a child and they've flagged it ever since.", "captured_at": "2026-02-03T09:15:00+00:00"}, {"turn_id": "t05", "role": "user", "text": "I think I might react to codeine too, but honestly I'm not certain.", "captured_at": "2026-02-03T09:15:00+00:00"}, {"turn_id": "t06", "role": "assistant", "text": "I'll note the penicillin firmly and the codeine as unconfirmed.", "captured_at": "2026-02-03T09:15:00+00:00"}, {"turn_id": "t07", "role": "assistant", "text": "What are you taking currently?", "captured_at": "2026-02-03T09:15:00+00:00"}, {"turn_id": "t08", "role": "user", "text": "Ramipril 5mg each morning. Been on it about two years.", "captured_at": "2026-02-03T09:15:00+00:00"}, {"turn_id": "t09", "role": "user", "text": "I was on amlodipine before that but we stopped it last spring.", "captured_at": "2026-02-03T09:15:00+00:00"}, {"turn_id": "t10", "role": "assistant", "text": "And your GP?", "captured_at": "2026-02-03T09:15:00+00:00"}, {"turn_id": "t11", "role": "user", "text": "Dr Hannah Reid at the Maple Street surgery.", "captured_at": "2026-02-03T09:15:00+00:00"}, {"turn_id": "t12", "role": "user", "text": "Sorry, my train's being announced - can we finish this later?", "captured_at": "2026-02-03T09:15:00+00:00"}]}
{"namespace": "patient:9002", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "I'd like to confirm a few details on your file.", "captured_at": "2026-02-04T11:40:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "Sure.", "captured_at": "2026-02-04T11:40:00+00:00"}, {"turn_id": "t03", "role": "assistant", "text": "Our records show blood type A positive. Is that right?", "captured_at": "2026-02-04T11:40:00+00:00"}, {"turn_id": "t04", "role": "user", "text": "No, that's wrong. I'm O negative - I've donated for years, I'd know.", "captured_at": "2026-02-04T11:40:00+00:00"}, {"turn_id": "t05", "role": "assistant", "text": "Thank you, I'll correct that.", "captured_at": "2026-02-04T11:40:00+00:00"}, {"turn_id": "t06", "role": "tool", "text": "EHR lookup: blood_type on file A+, last updated 2019, source self-reported.", "captured_at": "2026-02-04T11:40:00+00:00"}, {"turn_id": "t07", "role": "assistant", "text": "Any dietary requirements?", "captured_at": "2026-02-04T11:40:00+00:00"}, {"turn_id": "t08", "role": "user", "text": "Coeliac, so strictly gluten free. Not a preference, it makes me properly ill.", "captured_at": "2026-02-04T11:40:00+00:00"}, {"turn_id": "t09", "role": "assistant", "text": "Which pharmacy should prescriptions go to?", "captured_at": "2026-02-04T11:40:00+00:00"}, {"turn_id": "t10", "role": "user", "text": "The Well on Bridge Street.", "captured_at": "2026-02-04T11:40:00+00:00"}, {"turn_id": "t11", "role": "user", "text": "Although my partner usually collects them, if that matters.", "captured_at": "2026-02-04T11:40:00+00:00"}, {"turn_id": "t12", "role": "assistant", "text": "It doesn't affect the record, but noted.", "captured_at": "2026-02-04T11:40:00+00:00"}]}
{"namespace": "patient:9003", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "Thanks for calling in. What can I update?", "captured_at": "2026-02-05T14:05:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "I've moved. New address is 42 Kilnsey Grove, Bradford.", "captured_at": "2026-02-05T14:05:00+00:00"}, {"turn_id": "t03", "role": "assistant", "text": "When did that take effect?", "captured_at": "2026-02-05T14:05:00+00:00"}, {"turn_id": "t04", "role": "user", "text": "Start of January.", "captured_at": "2026-02-05T14:05:00+00:00"}, {"turn_id": "t05", "role": "assistant", "text": "And is your emergency contact still the same?", "captured_at": "2026-02-05T14:05:00+00:00"}, {"turn_id": "t06", "role": "user", "text": "No - it was my brother, but he's in Singapore now.", "captured_at": "2026-02-05T14:05:00+00:00"}, {"turn_id": "t07", "role": "user", "text": "Put my neighbour Priya Sandhu down instead. She has a key.", "captured_at": "2026-02-05T14:05:00+00:00"}, {"turn_id": "t08", "role": "assistant", "text": "Does she know she's listed?", "captured_at": "2026-02-05T14:05:00+00:00"}, {"turn_id": "t09", "role": "user", "text": "Yes, I asked her last week.", "captured_at": "2026-02-05T14:05:00+00:00"}, {"turn_id": "t10", "role": "assistant", "text": "Anything else changed?", "captured_at": "2026-02-05T14:05:00+00:00"}, {"turn_id": "t11", "role": "user", "text": "My weight's down to 71 kilos, if you track that.", "captured_at": "2026-02-05T14:05:00+00:00"}, {"turn_id": "t12", "role": "user", "text": "Oh and the weather's been awful, has it been like this your end?", "captured_at": "2026-02-05T14:05:00+00:00"}]}
{"namespace": "patient:9004", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "Before the consultation - can I check your medication list?", "captured_at": "2026-02-06T08:50:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "Metformin 1000mg twice daily.", "captured_at": "2026-02-06T08:50:00+00:00"}, {"turn_id": "t03", "role": "user", "text": "Gliclazide 80mg in the morning.", "captured_at": "2026-02-06T08:50:00+00:00"}, {"turn_id": "t04", "role": "user", "text": "And I take a multivitamin, but that's just off the shelf.", "captured_at": "2026-02-06T08:50:00+00:00"}, {"turn_id": "t05", "role": "assistant", "text": "Is the diabetes type 2?", "captured_at": "2026-02-06T08:50:00+00:00"}, {"turn_id": "t06", "role": "user", "text": "Yes, type 2, diagnosed about eight years ago.", "captured_at": "2026-02-06T08:50:00+00:00"}, {"turn_id": "t07", "role": "assistant", "text": "Any allergies?", "captured_at": "2026-02-06T08:50:00+00:00"}, {"turn_id": "t08", "role": "user", "text": "None that I know of.", "captured_at": "2026-02-06T08:50:00+00:00"}, {"turn_id": "t09", "role": "assistant", "text": "Insurance?", "captured_at": "2026-02-06T08:50:00+00:00"}, {"turn_id": "t10", "role": "user", "text": "I'm private through work - Meridian Health, I think the plan is called Select.", "captured_at": "2026-02-06T08:50:00+00:00"}, {"turn_id": "t11", "role": "user", "text": "I'd have to check the card to be sure about the plan name.", "captured_at": "2026-02-06T08:50:00+00:00"}, {"turn_id": "t12", "role": "assistant", "text": "I'll record the insurer and leave the plan pending.", "captured_at": "2026-02-06T08:50:00+00:00"}]}
{"namespace": "patient:9005", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "How can I help today?", "captured_at": "2026-02-09T16:20:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "I want to make sure my wishes are on file properly.", "captured_at": "2026-02-09T16:20:00+00:00"}, {"turn_id": "t03", "role": "user", "text": "I signed an advance directive with my solicitor in November.", "captured_at": "2026-02-09T16:20:00+00:00"}, {"turn_id": "t04", "role": "assistant", "text": "Do you have a reference for it?", "captured_at": "2026-02-09T16:20:00+00:00"}, {"turn_id": "t05", "role": "user", "text": "It's document ADV-2291. I posted a copy to the surgery.", "captured_at": "2026-02-09T16:20:00+00:00"}, {"turn_id": "t06", "role": "tool", "text": "EHR lookup: no advance_directive record found for this patient.", "captured_at": "2026-02-09T16:20:00+00:00"}, {"turn_id": "t07", "role": "assistant", "text": "It hasn't reached us. I'll flag it for the records team.", "captured_at": "2026-02-09T16:20:00+00:00"}, {"turn_id": "t08", "role": "assistant", "text": "While you're on - may we share your records with the cardiology clinic?", "captured_at": "2026-02-09T16:20:00+00:00"}, {"turn_id": "t09", "role": "user", "text": "Yes, you can share them with cardiology. Not with anyone else.", "captured_at": "2026-02-09T16:20:00+00:00"}, {"turn_id": "t10", "role": "assistant", "text": "Understood, cardiology only.", "captured_at": "2026-02-09T16:20:00+00:00"}, {"turn_id": "t11", "role": "user", "text": "My husband thinks I should refuse everything, but it's my decision.", "captured_at": "2026-02-09T16:20:00+00:00"}]}
{"namespace": "patient:9006", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "I'm checking a few gaps in your notes.", "captured_at": "2026-02-10T10:10:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "Fine.", "captured_at": "2026-02-10T10:10:00+00:00"}, {"turn_id": "t03", "role": "assistant", "text": "Preferred language for letters?", "captured_at": "2026-02-10T10:10:00+00:00"}, {"turn_id": "t04", "role": "user", "text": "Polish, please. My English is fine spoken but I miss things in writing.", "captured_at": "2026-02-10T10:10:00+00:00"}, {"turn_id": "t05", "role": "assistant", "text": "Noted. Do you have a regular pharmacy?", "captured_at": "2026-02-10T10:10:00+00:00"}, {"turn_id": "t06", "role": "user", "text": "Not really. Whichever is open.", "captured_at": "2026-02-10T10:10:00+00:00"}, {"turn_id": "t07", "role": "assistant", "text": "I'll leave that blank then.", "captured_at": "2026-02-10T10:10:00+00:00"}, {"turn_id": "t08", "role": "assistant", "text": "Any long-term conditions we should list?", "captured_at": "2026-02-10T10:10:00+00:00"}, {"turn_id": "t09", "role": "user", "text": "Asthma since childhood.", "captured_at": "2026-02-10T10:10:00+00:00"}, {"turn_id": "t10", "role": "user", "text": "My mother has COPD, but that's her, not me.", "captured_at": "2026-02-10T10:10:00+00:00"}, {"turn_id": "t11", "role": "assistant", "text": "Right, I'll record the asthma only.", "captured_at": "2026-02-10T10:10:00+00:00"}, {"turn_id": "t12", "role": "user", "text": "I might be starting a new inhaler soon, the GP mentioned it.", "captured_at": "2026-02-10T10:10:00+00:00"}]}
{"namespace": "patient:9007", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "You asked to correct something?", "captured_at": "2026-02-11T13:30:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "Yes. You have me down as allergic to shellfish. That was a mistake.", "captured_at": "2026-02-11T13:30:00+00:00"}, {"turn_id": "t03", "role": "user", "text": "It was food poisoning from mussels, not an allergy. I tested negative.", "captured_at": "2026-02-11T13:30:00+00:00"}, {"turn_id": "t04", "role": "assistant", "text": "Thank you, I'll remove it.", "captured_at": "2026-02-11T13:30:00+00:00"}, {"turn_id": "t05", "role": "assistant", "text": "Is the latex allergy still accurate?", "captured_at": "2026-02-11T13:30:00+00:00"}, {"turn_id": "t06", "role": "user", "text": "Yes, that one's real. Gloves bring me out in a rash.", "captured_at": "2026-02-11T13:30:00+00:00"}, {"turn_id": "t07", "role": "assistant", "text": "And your GP is still Dr Oyelaran?", "captured_at": "2026-02-11T13:30:00+00:00"}, {"turn_id": "t08", "role": "user", "text": "She left in December. It's Dr Marcus Bell now.", "captured_at": "2026-02-11T13:30:00+00:00"}, {"turn_id": "t09", "role": "assistant", "text": "Anything else?", "captured_at": "2026-02-11T13:30:00+00:00"}, {"turn_id": "t10", "role": "user", "text": "My care plan should be active again, I restarted physio.", "captured_at": "2026-02-11T13:30:00+00:00"}, {"turn_id": "t11", "role": "tool", "text": "EHR lookup: care_plan_status = paused, set 2025-11-02.", "captured_at": "2026-02-11T13:30:00+00:00"}]}
{"namespace": "patient:9008", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "New patient registration - a few basics.", "captured_at": "2026-02-12T09:00:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "Right.", "captured_at": "2026-02-12T09:00:00+00:00"}, {"turn_id": "t03", "role": "assistant", "text": "Any allergies?", "captured_at": "2026-02-12T09:00:00+00:00"}, {"turn_id": "t04", "role": "user", "text": "Sulfa drugs. And ibuprofen upsets my stomach, but that's not an allergy as such.", "captured_at": "2026-02-12T09:00:00+00:00"}, {"turn_id": "t05", "role": "assistant", "text": "Current medication?", "captured_at": "2026-02-12T09:00:00+00:00"}, {"turn_id": "t06", "role": "user", "text": "Levothyroxine 100 micrograms daily.", "captured_at": "2026-02-12T09:00:00+00:00"}, {"turn_id": "t07", "role": "assistant", "text": "For an underactive thyroid?", "captured_at": "2026-02-12T09:00:00+00:00"}, {"turn_id": "t08", "role": "user", "text": "Yes, hypothyroidism.", "captured_at": "2026-02-12T09:00:00+00:00"}, {"turn_id": "t09", "role": "assistant", "text": "Emergency contact?", "captured_at": "2026-02-12T09:00:00+00:00"}, {"turn_id": "t10", "role": "user", "text": "My daughter, Kate Milburn.", "captured_at": "2026-02-12T09:00:00+00:00"}, {"turn_id": "t11", "role": "assistant", "text": "Weight, if you know it?", "captured_at": "2026-02-12T09:00:00+00:00"}, {"turn_id": "t12", "role": "user", "text": "Around 90 kilos? I haven't weighed myself in a while.", "captured_at": "2026-02-12T09:00:00+00:00"}]}
{"namespace": "patient:9009", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "Thanks for holding. What did you need?", "captured_at": "2026-02-13T15:45:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "Just confirming my prescription goes to the right place.", "captured_at": "2026-02-13T15:45:00+00:00"}, {"turn_id": "t03", "role": "user", "text": "Lloyds in the retail park, not the one in town.", "captured_at": "2026-02-13T15:45:00+00:00"}, {"turn_id": "t04", "role": "assistant", "text": "Updated. Anything else on file to change?", "captured_at": "2026-02-13T15:45:00+00:00"}, {"turn_id": "t05", "role": "user", "text": "My insurance renewed - still Northwind Health, same plan.", "captured_at": "2026-02-13T15:45:00+00:00"}, {"turn_id": "t06", "role": "assistant", "text": "So no change there.", "captured_at": "2026-02-13T15:45:00+00:00"}, {"turn_id": "t07", "role": "user", "text": "Correct.", "captured_at": "2026-02-13T15:45:00+00:00"}, {"turn_id": "t08", "role": "assistant", "text": "And you're still on the low sodium diet?", "captured_at": "2026-02-13T15:45:00+00:00"}, {"turn_id": "t09", "role": "user", "text": "Yes, the dietitian was clear about that.", "captured_at": "2026-02-13T15:45:00+00:00"}, {"turn_id": "t10", "role": "user", "text": "I've been cheating at weekends, but don't write that down.", "captured_at": "2026-02-13T15:45:00+00:00"}, {"turn_id": "t11", "role": "assistant", "text": "I'll record the restriction as advised.", "captured_at": "2026-02-13T15:45:00+00:00"}]}
{"namespace": "patient:9010", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "I have your intake form but a few fields are blank.", "captured_at": "2026-02-16T11:25:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "Sorry, I rushed it.", "captured_at": "2026-02-16T11:25:00+00:00"}, {"turn_id": "t03", "role": "assistant", "text": "Blood type?", "captured_at": "2026-02-16T11:25:00+00:00"}, {"turn_id": "t04", "role": "user", "text": "AB positive.", "captured_at": "2026-02-16T11:25:00+00:00"}, {"turn_id": "t05", "role": "assistant", "text": "Any regular medication?", "captured_at": "2026-02-16T11:25:00+00:00"}, {"turn_id": "t06", "role": "user", "text": "Sertraline 50mg. Started three months ago.", "captured_at": "2026-02-16T11:25:00+00:00"}, {"turn_id": "t07", "role": "user", "text": "I may come off it in the summer, we'll see how it goes.", "captured_at": "2026-02-16T11:25:00+00:00"}, {"turn_id": "t08", "role": "assistant", "text": "Allergies?", "captured_at": "2026-02-16T11:25:00+00:00"}, {"turn_id": "t09", "role": "user", "text": "No.", "captured_at": "2026-02-16T11:25:00+00:00"}, {"turn_id": "t10", "role": "assistant", "text": "Address?", "captured_at": "2026-02-16T11:25:00+00:00"}, {"turn_id": "t11", "role": "user", "text": "8 Cranmer Close, Sheffield.", "captured_at": "2026-02-16T11:25:00+00:00"}, {"turn_id": "t12", "role": "assistant", "text": "That's everything, thank you.", "captured_at": "2026-02-16T11:25:00+00:00"}]}
{"namespace": "patient:9011", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "Good morning. I'm told you wanted to add something to your notes.", "captured_at": "2026-02-17T09:35:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "My consent. I don't want my data shared with the research study.", "captured_at": "2026-02-17T09:35:00+00:00"}, {"turn_id": "t03", "role": "assistant", "text": "So consent withdrawn for research?", "captured_at": "2026-02-17T09:35:00+00:00"}, {"turn_id": "t04", "role": "user", "text": "Yes. Withdrawn. I signed up two years ago and I've changed my mind.", "captured_at": "2026-02-17T09:35:00+00:00"}, {"turn_id": "t05", "role": "assistant", "text": "That's recorded. Anything else?", "captured_at": "2026-02-17T09:35:00+00:00"}, {"turn_id": "t06", "role": "user", "text": "My pharmacy has closed down. The Bridge Street one.", "captured_at": "2026-02-17T09:35:00+00:00"}, {"turn_id": "t07", "role": "assistant", "text": "Where would you like prescriptions sent instead?", "captured_at": "2026-02-17T09:35:00+00:00"}, {"turn_id": "t08", "role": "user", "text": "Haven't decided yet. I'll ring when I have.", "captured_at": "2026-02-17T09:35:00+00:00"}, {"turn_id": "t09", "role": "assistant", "text": "I'll leave it unset rather than guess.", "captured_at": "2026-02-17T09:35:00+00:00"}, {"turn_id": "t10", "role": "user", "text": "Good. My wife uses the Tesco one but I don't like it.", "captured_at": "2026-02-17T09:35:00+00:00"}]}
{"namespace": "patient:9012", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "Pre-operative check. Allergies first.", "captured_at": "2026-02-18T14:50:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "Anaesthetic - I had a bad reaction to something during a hernia repair in 2018.", "captured_at": "2026-02-18T14:50:00+00:00"}, {"turn_id": "t03", "role": "assistant", "text": "Do you know which agent?", "captured_at": "2026-02-18T14:50:00+00:00"}, {"turn_id": "t04", "role": "user", "text": "No, they never told me the name. Just that it happened.", "captured_at": "2026-02-18T14:50:00+00:00"}, {"turn_id": "t05", "role": "assistant", "text": "I'll flag it as an unspecified anaesthetic reaction for the team to chase.", "captured_at": "2026-02-18T14:50:00+00:00"}, {"turn_id": "t06", "role": "assistant", "text": "Blood type?", "captured_at": "2026-02-18T14:50:00+00:00"}, {"turn_id": "t07", "role": "user", "text": "B positive.", "captured_at": "2026-02-18T14:50:00+00:00"}, {"turn_id": "t08", "role": "assistant", "text": "Current medication?", "captured_at": "2026-02-18T14:50:00+00:00"}, {"turn_id": "t09", "role": "user", "text": "Apixaban 5mg twice daily. That's the one they'll care about.", "captured_at": "2026-02-18T14:50:00+00:00"}, {"turn_id": "t10", "role": "assistant", "text": "It is. And your emergency contact?", "captured_at": "2026-02-18T14:50:00+00:00"}, {"turn_id": "t11", "role": "user", "text": "My son, Daniel Harding.", "captured_at": "2026-02-18T14:50:00+00:00"}, {"turn_id": "t12", "role": "user", "text": "He's a nurse, so he'll understand what you tell him.", "captured_at": "2026-02-18T14:50:00+00:00"}]}
{"namespace": "patient:9013", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "You mentioned a change of circumstances?", "captured_at": "2026-02-19T10:05:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "I've been made redundant, so I've lost the private cover.", "captured_at": "2026-02-19T10:05:00+00:00"}, {"turn_id": "t03", "role": "assistant", "text": "So the Meridian policy has lapsed?", "captured_at": "2026-02-19T10:05:00+00:00"}, {"turn_id": "t04", "role": "user", "text": "Yes, end of January. NHS only now.", "captured_at": "2026-02-19T10:05:00+00:00"}, {"turn_id": "t05", "role": "assistant", "text": "I'll update the insurance record.", "captured_at": "2026-02-19T10:05:00+00:00"}, {"turn_id": "t06", "role": "user", "text": "My weight's gone up too - 84 kilos at the last check.", "captured_at": "2026-02-19T10:05:00+00:00"}, {"turn_id": "t07", "role": "assistant", "text": "Noted. Is the care plan still running?", "captured_at": "2026-02-19T10:05:00+00:00"}, {"turn_id": "t08", "role": "user", "text": "Yes, that's unaffected.", "captured_at": "2026-02-19T10:05:00+00:00"}, {"turn_id": "t09", "role": "user", "text": "Stressful few months, honestly.", "captured_at": "2026-02-19T10:05:00+00:00"}, {"turn_id": "t10", "role": "assistant", "text": "I'm sorry to hear it. Anything clinical I should add?", "captured_at": "2026-02-19T10:05:00+00:00"}, {"turn_id": "t11", "role": "user", "text": "Not really. Sleeping badly but I'm not making it a medical thing.", "captured_at": "2026-02-19T10:05:00+00:00"}]}
{"namespace": "patient:9014", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "I'm calling about the letter we sent - it came back undelivered.", "captured_at": "2026-02-20T16:00:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "Right, I moved in December. 17 Farrier Lane, York.", "captured_at": "2026-02-20T16:00:00+00:00"}, {"turn_id": "t03", "role": "assistant", "text": "Thank you. Is the phone number still current?", "captured_at": "2026-02-20T16:00:00+00:00"}, {"turn_id": "t04", "role": "user", "text": "Yes.", "captured_at": "2026-02-20T16:00:00+00:00"}, {"turn_id": "t05", "role": "assistant", "text": "And your preferred language is still English?", "captured_at": "2026-02-20T16:00:00+00:00"}, {"turn_id": "t06", "role": "user", "text": "Yes, English.", "captured_at": "2026-02-20T16:00:00+00:00"}, {"turn_id": "t07", "role": "assistant", "text": "While I have you, are you still on the gluten free diet?", "captured_at": "2026-02-20T16:00:00+00:00"}, {"turn_id": "t08", "role": "user", "text": "That was never me. You've mixed me up with someone.", "captured_at": "2026-02-20T16:00:00+00:00"}, {"turn_id": "t09", "role": "assistant", "text": "Apologies - I'll check that and remove it if it's wrong.", "captured_at": "2026-02-20T16:00:00+00:00"}, {"turn_id": "t10", "role": "tool", "text": "EHR lookup: dietary_restriction = gluten_free, source unknown, no date.", "captured_at": "2026-02-20T16:00:00+00:00"}, {"turn_id": "t11", "role": "user", "text": "Please do, I eat bread every day.", "captured_at": "2026-02-20T16:00:00+00:00"}]}
{"namespace": "patient:9015", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "Annual review. Let's start with medication.", "captured_at": "2026-02-23T11:15:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "Atorvastatin 40mg at night.", "captured_at": "2026-02-23T11:15:00+00:00"}, {"turn_id": "t03", "role": "user", "text": "Aspirin 75mg in the morning.", "captured_at": "2026-02-23T11:15:00+00:00"}, {"turn_id": "t04", "role": "user", "text": "And I stopped the omeprazole in the autumn - it wasn't helping.", "captured_at": "2026-02-23T11:15:00+00:00"}, {"turn_id": "t05", "role": "assistant", "text": "So omeprazole is discontinued.", "captured_at": "2026-02-23T11:15:00+00:00"}, {"turn_id": "t06", "role": "user", "text": "Yes.", "captured_at": "2026-02-23T11:15:00+00:00"}, {"turn_id": "t07", "role": "assistant", "text": "Any new diagnoses since we last spoke?", "captured_at": "2026-02-23T11:15:00+00:00"}, {"turn_id": "t08", "role": "user", "text": "Angina, confirmed in October.", "captured_at": "2026-02-23T11:15:00+00:00"}, {"turn_id": "t09", "role": "assistant", "text": "Allergies unchanged?", "captured_at": "2026-02-23T11:15:00+00:00"}, {"turn_id": "t10", "role": "user", "text": "Still penicillin, yes.", "captured_at": "2026-02-23T11:15:00+00:00"}, {"turn_id": "t11", "role": "assistant", "text": "And your GP?", "captured_at": "2026-02-23T11:15:00+00:00"}, {"turn_id": "t12", "role": "user", "text": "Dr Reid, same as before.", "captured_at": "2026-02-23T11:15:00+00:00"}]}
{"namespace": "patient:9016", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "What can I do for you?", "captured_at": "2026-02-24T13:40:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "I want my emergency contact changed. Urgently.", "captured_at": "2026-02-24T13:40:00+00:00"}, {"turn_id": "t03", "role": "assistant", "text": "Of course.", "captured_at": "2026-02-24T13:40:00+00:00"}, {"turn_id": "t04", "role": "user", "text": "Remove my ex-partner. Completely. Anna Whitfield.", "captured_at": "2026-02-24T13:40:00+00:00"}, {"turn_id": "t05", "role": "assistant", "text": "Removed. Who should replace her?", "captured_at": "2026-02-24T13:40:00+00:00"}, {"turn_id": "t06", "role": "user", "text": "My mother, Elaine Whitfield. Different person, same surname, I know it's confusing.", "captured_at": "2026-02-24T13:40:00+00:00"}, {"turn_id": "t07", "role": "assistant", "text": "I'll make sure it's the right one.", "captured_at": "2026-02-24T13:40:00+00:00"}, {"turn_id": "t08", "role": "user", "text": "Thank you. That matters to me.", "captured_at": "2026-02-24T13:40:00+00:00"}, {"turn_id": "t09", "role": "assistant", "text": "Understood. Anything else while the file is open?", "captured_at": "2026-02-24T13:40:00+00:00"}, {"turn_id": "t10", "role": "user", "text": "No. Actually - my address is the same, don't change that.", "captured_at": "2026-02-24T13:40:00+00:00"}]}
{"namespace": "patient:9017", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "Early appointment, sorry. Quick record check.", "captured_at": "2026-02-25T08:20:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "No problem, I'm up.", "captured_at": "2026-02-25T08:20:00+00:00"}, {"turn_id": "t03", "role": "assistant", "text": "Allergies?", "captured_at": "2026-02-25T08:20:00+00:00"}, {"turn_id": "t04", "role": "user", "text": "Bee stings. Anaphylaxis, I carry an EpiPen.", "captured_at": "2026-02-25T08:20:00+00:00"}, {"turn_id": "t05", "role": "assistant", "text": "That's important, thank you. Medication?", "captured_at": "2026-02-25T08:20:00+00:00"}, {"turn_id": "t06", "role": "user", "text": "Just the EpiPen, and cetirizine in summer.", "captured_at": "2026-02-25T08:20:00+00:00"}, {"turn_id": "t07", "role": "assistant", "text": "Preferred pharmacy?", "captured_at": "2026-02-25T08:20:00+00:00"}, {"turn_id": "t08", "role": "user", "text": "Boots on the high street.", "captured_at": "2026-02-25T08:20:00+00:00"}, {"turn_id": "t09", "role": "assistant", "text": "Blood type, if known?", "captured_at": "2026-02-25T08:20:00+00:00"}, {"turn_id": "t10", "role": "user", "text": "I genuinely don't know.", "captured_at": "2026-02-25T08:20:00+00:00"}, {"turn_id": "t11", "role": "assistant", "text": "That's fine, I'll leave it blank.", "captured_at": "2026-02-25T08:20:00+00:00"}, {"turn_id": "t12", "role": "user", "text": "My brother's O positive if that's any use.", "captured_at": "2026-02-25T08:20:00+00:00"}]}
{"namespace": "patient:9018", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "Following up on the discharge summary.", "captured_at": "2026-02-26T15:10:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "Yes?", "captured_at": "2026-02-26T15:10:00+00:00"}, {"turn_id": "t03", "role": "assistant", "text": "It lists a new diagnosis of atrial fibrillation. Can you confirm?", "captured_at": "2026-02-26T15:10:00+00:00"}, {"turn_id": "t04", "role": "user", "text": "That's right, they picked it up on the ward.", "captured_at": "2026-02-26T15:10:00+00:00"}, {"turn_id": "t05", "role": "assistant", "text": "And they started you on something?", "captured_at": "2026-02-26T15:10:00+00:00"}, {"turn_id": "t06", "role": "user", "text": "Bisoprolol 2.5mg. And they mentioned warfarin but I never got a prescription.", "captured_at": "2026-02-26T15:10:00+00:00"}, {"turn_id": "t07", "role": "assistant", "text": "I'll record the bisoprolol and query the warfarin.", "captured_at": "2026-02-26T15:10:00+00:00"}, {"turn_id": "t08", "role": "tool", "text": "EHR lookup: discharge summary lists bisoprolol 2.5mg; no anticoagulant issued.", "captured_at": "2026-02-26T15:10:00+00:00"}, {"turn_id": "t09", "role": "assistant", "text": "Is your care plan active?", "captured_at": "2026-02-26T15:10:00+00:00"}, {"turn_id": "t10", "role": "user", "text": "Yes, cardiology are following me up in six weeks.", "captured_at": "2026-02-26T15:10:00+00:00"}, {"turn_id": "t11", "role": "user", "text": "I should say my memory's not great since the admission.", "captured_at": "2026-02-26T15:10:00+00:00"}]}
{"namespace": "patient:9019", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "Registration for the new practice. A few questions.", "captured_at": "2026-02-27T12:00:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "Right, go on.", "captured_at": "2026-02-27T12:00:00+00:00"}, {"turn_id": "t03", "role": "assistant", "text": "Preferred language?", "captured_at": "2026-02-27T12:00:00+00:00"}, {"turn_id": "t04", "role": "user", "text": "Urdu for letters, English is fine on the phone.", "captured_at": "2026-02-27T12:00:00+00:00"}, {"turn_id": "t05", "role": "assistant", "text": "Noted - Urdu for written correspondence.", "captured_at": "2026-02-27T12:00:00+00:00"}, {"turn_id": "t06", "role": "assistant", "text": "Any allergies?", "captured_at": "2026-02-27T12:00:00+00:00"}, {"turn_id": "t07", "role": "user", "text": "Aspirin. Brings on wheezing.", "captured_at": "2026-02-27T12:00:00+00:00"}, {"turn_id": "t08", "role": "assistant", "text": "Long-term conditions?", "captured_at": "2026-02-27T12:00:00+00:00"}, {"turn_id": "t09", "role": "user", "text": "High blood pressure. And asthma, mild.", "captured_at": "2026-02-27T12:00:00+00:00"}, {"turn_id": "t10", "role": "assistant", "text": "Medication for those?", "captured_at": "2026-02-27T12:00:00+00:00"}, {"turn_id": "t11", "role": "user", "text": "Amlodipine 5mg, and a blue inhaler as needed.", "captured_at": "2026-02-27T12:00:00+00:00"}, {"turn_id": "t12", "role": "user", "text": "My previous surgery should have all this, if that's easier.", "captured_at": "2026-02-27T12:00:00+00:00"}]}
{"namespace": "patient:9020", "source_tier": "verified_user", "turns": [{"turn_id": "t01", "role": "assistant", "text": "Thanks for coming in. I'll update as we go.", "captured_at": "2026-03-02T09:45:00+00:00"}, {"turn_id": "t02", "role": "user", "text": "My address has changed - 3 Calder Way, Leeds.", "captured_at": "2026-03-02T09:45:00+00:00"}, {"turn_id": "t03", "role": "assistant", "text": "From the Ashfield Road one?", "captured_at": "2026-03-02T09:45:00+00:00"}, {"turn_id": "t04", "role": "user", "text": "Yes, we completed last month.", "captured_at": "2026-03-02T09:45:00+00:00"}, {"turn_id": "t05", "role": "assistant", "text": "Updated. Pharmacy?", "captured_at": "2026-03-02T09:45:00+00:00"}, {"turn_id": "t06", "role": "user", "text": "Change that too - the CVS near the new place. CVS #4021.", "captured_at": "2026-03-02T09:45:00+00:00"}, {"turn_id": "t07", "role": "assistant", "text": "Done. Anything clinical?", "captured_at": "2026-03-02T09:45:00+00:00"}, {"turn_id": "t08", "role": "user", "text": "Weight 76 kilos. Down a bit.", "captured_at": "2026-03-02T09:45:00+00:00"}, {"turn_id": "t09", "role": "assistant", "text": "And your emergency contact?", "captured_at": "2026-03-02T09:45:00+00:00"}, {"turn_id": "t10", "role": "user", "text": "Still my daughter Ruth.", "captured_at": "2026-03-02T09:45:00+00:00"}, {"turn_id": "t11", "role": "user", "text": "Same number, before you ask.", "captured_at": "2026-03-02T09:45:00+00:00"}]}
