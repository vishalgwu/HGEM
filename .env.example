# =============================================================================
# GuardMem AI (HGEM) - environment template
# =============================================================================
# Copy to .env and fill in the secrets:   cp .env.example .env
#
# .env is gitignored and MUST stay that way. This file (.env.example) is the
# committed template - it must never contain a real key.
#
# PRD.md 6.3: "zero secrets in env files in prod". This file is a DEV
# convenience only. Staging and prod read from Secret Manager / Vault, and
# gitleaks + detect-secrets run in pre-commit and CI to keep it that way.
#
# -----------------------------------------------------------------------------
# READ THIS BEFORE ADDING A LINE
# -----------------------------------------------------------------------------
# settings.py uses SettingsConfigDict(env_prefix="GM_", extra="forbid").
# extra="forbid" means Settings() raises ValidationError on ANY key in this file
# that is not a declared field - including keys with no GM_ prefix. Both cases
# were tested against pydantic-settings 2.15.0:
#
#     GM_BUDGET_DAILY_USD=25       -> ValidationError: extra_forbidden
#     GOOGLE_CLOUD_PROJECT=x       -> ValidationError: extra_forbidden
#
# So the ACTIVE section below contains exactly the fields settings.py declares
# at S1.4, and nothing else. Everything for a later step is commented out with
# the step that turns it on. Uncomment a line only in the same commit that adds
# its field to Settings, or the app stops booting.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SECRETS - paste from your password manager, never commit
# -----------------------------------------------------------------------------
# S0.2 DONE WHEN: "all keys are pasted into a password manager, and none of them
# are in a file yet." The password manager stays the source of truth; this file
# is a working copy for local dev only.

# Anthropic - needed Day 2 (S2.2). Primary provider: extraction + adjudication.
# console.anthropic.com -> API keys. Format: sk-ant-api03-...
GM_ANTHROPIC_API_KEY=

# OpenAI - needed Day 9 (S9.1) as the fallback provider, and from Day 3 (S3.2)
# for GM_EMBED_MODEL embeddings. platform.openai.com -> API keys. Format: sk-proj-...
GM_OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# 2. Runtime
# -----------------------------------------------------------------------------
GM_ENV=dev


# -----------------------------------------------------------------------------
# 3. Datastores - these values match infra/docker/docker-compose.dev.yml (S1.3)
# -----------------------------------------------------------------------------
# Nothing here is a real secret in dev; the compose stack hardcodes the same
# credentials. In prod every one of these comes from Secret Manager.

GM_DATABASE_URL=postgresql+asyncpg://guardmem:guardmem@localhost:5432/guardmem
GM_REDIS_URL=redis://localhost:6379/0
GM_NEO4J_URI=bolt://localhost:7687
GM_NEO4J_USER=neo4j
GM_NEO4J_PASSWORD=guardmem123

# If a port is taken, the compose file publishes every one through a shell
# override, so no edit to it is needed - only to the URLs above:
#
#     POSTGRES_PORT=5433 REDIS_PORT=6380 NEO4J_HTTP_PORT=7475 #       NEO4J_BOLT_PORT=7688 make dev
#
# Those variables are read by docker compose from the SHELL. Do not add them to
# this file: they have no GM_ prefix precisely because Settings is
# extra="forbid" and would reject them, and giving them one would be worse.
#
# "Address already in use" is usually another CONTAINER rather than a local
# Postgres install - a stack with `restart: unless-stopped` returns every time
# Docker Desktop starts. `docker ps` first (BUILD_NOTEBOOK.md S1.3
# troubleshooting).


# -----------------------------------------------------------------------------
# 4. Model pins - RULES.md 3: exact published ids, never floating aliases
# -----------------------------------------------------------------------------
# Replay is only honest if the id is pinned. Do NOT append a date suffix to a
# current Claude id - claude-haiku-4-5-20251001 is not a valid model. These
# three ids are complete as written.
#
# Tiering (ARCHITECTURE.md 2.8):
#   FAST      noise filter + low-risk extraction   ~84% of calls
#   BALANCED  conflict adjudication + NLI          ~11%
#   FRONTIER  ESCALATE only                        <=6%

GM_MODEL_FAST=claude-haiku-4-5
GM_MODEL_BALANCED=claude-sonnet-5
GM_MODEL_FRONTIER=claude-opus-5
GM_EMBED_MODEL=text-embedding-3-large


# -----------------------------------------------------------------------------
# 5. Decision thresholds - MEMORY_ENGINE.md 3.4 is the spec of record
# -----------------------------------------------------------------------------
# Four confidence bands need three confidence thresholds. tau_mid is the 0.60
# boundary in the decision matrix; without it that number is hardcoded inside
# decide() and the matrix cannot be tuned per namespace.
#
# Bands are half-open: the lower bound is inclusive, the upper exclusive, so a C
# exactly on a boundary falls in the HIGHER band. Invariant I4 depends on it.
#
# Order is validated: tau_lo < tau_mid < tau_hi and rho_lo < rho_hi.
# These are defaults. Per-tenant/per-namespace overrides are versioned policy
# (PRD FR-3.3) and a change to them is an audited event - not an edit to this file.

GM_TAU_LO=0.45
GM_TAU_MID=0.60
GM_TAU_HI=0.78
GM_RHO_LO=0.35
GM_RHO_HI=0.70
# PRD.md FR-3.3 makes a threshold change an audited event: every
# DecisionRecord names the set that produced it. Bump when any of the five move.
GM_THRESHOLDS_VERSION=v1


# -----------------------------------------------------------------------------
# 6. Pipeline tuning
# -----------------------------------------------------------------------------
# K is normally chosen per-candidate by risk hint (1 LOW / 3 default / 5 HIGH,
# MEMORY_ENGINE.md 1.2). GM_DEFAULT_K is the fallback when no hint is supplied.
GM_DEFAULT_K=3

# Bounded fan-out over candidates. RULES.md 2.2 forbids unbounded gather.
GM_MAX_CONCURRENT_SCORES=8

# RULES.md 2.2: every outbound call has an explicit timeout. No timeout = CI failure.
GM_LLM_TIMEOUT_S=20.0
GM_STORE_TIMEOUT_S=5.0


# =============================================================================
# 7. NOT YET ACTIVE
# =============================================================================
# Every variable this project will need that settings.py does not declare yet.
# This file is the inventory - it used to cite BUILD_NOTEBOOK.md Appendix B,
# which does not exist. Uncommenting one before its step adds the field to
# Settings will crash the app at import with extra_forbidden. Turn each on in
# the same commit as its field.

# --- S7.1  graph backend swap: neo4j | networkx -------------------------------
# Build against networkx first; Neo4j swaps in by config with no code change.
# GM_GRAPH_BACKEND=networkx

# --- S8.4  raw payload blob storage ------------------------------------------
# Hashed source text. Local path in dev, GCS bucket in prod.
# GM_BLOB_PATH=./.data/blobs
# GM_BLOB_BUCKET=

# --- S10.2  budget hard cap ---------------------------------------------------
# On hard cap AUTO_WRITE is disabled and everything routes to HITL. Never an
# unlogged write. Cost envelope target is $0.0009 per governed candidate.
# GM_BUDGET_DAILY_USD=25

# --- S11.3  PII vault ---------------------------------------------------------
# Separate credentials AND a separate DB role from the main store. In prod this
# is a separate Cloud SQL instance with its own CMEK.
# GM_PII_VAULT_URL=postgresql+asyncpg://gm_vault:CHANGEME@localhost:5432/guardmem

# --- S13.1  observability -----------------------------------------------------
# Langfuse and Phoenix are self-hosted in the dev compose stack (localhost:3010
# and :6006), so cloud keys are only needed if you skip self-hosting.
# GM_OTEL_ENDPOINT=http://localhost:4317
# GM_LANGFUSE_PUBLIC_KEY=
# GM_LANGFUSE_SECRET_KEY=


# =============================================================================
# 8. Accounts that need no GM_ variable
# =============================================================================
# From the S0.2 account table. Listed so nothing looks forgotten.
#
#   GitHub        Day 1   Repo + Actions CI. Uses your git credential helper,
#                         not an env var. Already configured: origin is
#                         https://github.com/vishalgwu/HGEM.git
#
#   Google Cloud  Day 26  Cloud Run, Cloud SQL, Secret Manager. Create the
#                         project on day 0 anyway - billing enablement can take
#                         hours. Auth is "gcloud auth application-default login"
#                         or a service-account key referenced by
#                         GOOGLE_APPLICATION_CREDENTIALS - which must live in
#                         your SHELL, not in this file (it has no GM_ prefix and
#                         would be rejected by extra="forbid").
#
#   Langfuse      Day 13  Self-hosted in compose. Cloud keys only if you skip
#                         self-hosting - see section 7.
#
#   Neo4j Aura    Day 7   Optional; dev stays on the docker Neo4j. To use Aura,
#                         point GM_NEO4J_URI at neo4j+s://<id>.databases.neo4j.io
#                         and set GM_NEO4J_PASSWORD to the generated password.
#
# Docker Compose reads POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB /
# NEO4J_AUTH, but S1.3 hardcodes them in the compose file. Do not add them here:
# they have no GM_ prefix and Settings() would reject the file.
