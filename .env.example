# Copy this file to .env and fill in real values. Never commit .env.

# ─── App ─────────────────────────────────────────────────────────────
APP_ENV=dev                    # dev | staging | prod
LOG_LEVEL=INFO
GATEWAY_PORT=8080
DASHBOARD_PORT=3000

# ─── Postgres + pgvector ─────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=guardmem
POSTGRES_USER=guardmem
POSTGRES_PASSWORD=guardmem
DATABASE_URL=postgresql+asyncpg://guardmem:guardmem@localhost:5432/guardmem

# ─── Neo4j ───────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=guardmem

# ─── Redis (arq queue + rate limits + semantic cache) ────────────────
REDIS_URL=redis://localhost:6379/0

# ─── LLM providers ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional cloud providers
AWS_BEDROCK_REGION=
GOOGLE_APPLICATION_CREDENTIALS=
# Local fallback
OLLAMA_HOST=http://localhost:11434

# ─── LLM router tiers ────────────────────────────────────────────────
GUARDMEM_LLM_FAST=claude-haiku-4-5-20251001
GUARDMEM_LLM_BALANCED=claude-sonnet-5
GUARDMEM_LLM_FRONTIER=claude-opus-5

# ─── Observability ───────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
PHOENIX_HOST=http://localhost:6006

# ─── Auth (dashboard + gateway) ──────────────────────────────────────
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
JWT_SIGNING_SECRET=change-me

# ─── Tenancy / budgets ───────────────────────────────────────────────
DEFAULT_TENANT_ID=demo
DEFAULT_TENANT_DAILY_TOKEN_BUDGET=2000000
DEFAULT_TENANT_DAILY_USD_BUDGET=50

# ─── Feature flags ───────────────────────────────────────────────────
GUARDMEM_STRICT_MODE_ALLOWED=true
GUARDMEM_ENABLE_NEO4J=false      # true switches store router to Neo4j
