# --- Python environments -----------------------------------------------------
.venv/
venv/
ENV/

# --- Python build & cache artifacts ------------------------------------------
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
build/
dist/
.eggs/

# --- Tool caches -------------------------------------------------------------
.ruff_cache/
.mypy_cache/
.pytest_cache/
.hypothesis/
.uv-cache/
# Grimp writes its own `.gitignore` containing `*` inside this directory, so it
# is already ignored in practice - but that is the tool's internals doing our
# repo hygiene, which is the same reason .pytest_cache/ is listed above.
# Worth knowing: this cache is keyed on file mtime, so restoring a file with an
# OLDER mtime (a `mv` of a backup, a `git checkout` of a prior revision) leaves
# Grimp serving the previous result. That produces a false FAIL, and equally a
# false PASS. Delete the directory when lint-imports disagrees with the source.
.import_linter_cache/

# --- Coverage & test output --------------------------------------------------
.coverage
.coverage.*
coverage.xml
htmlcov/
junit*.xml

# --- Secrets and local configuration -----------------------------------------
# .env.* is broad on purpose: it catches .env.local, .env.prod and anything else
# someone invents. The negation below is what keeps the committed template
# tracked, and it must stay after the pattern that would otherwise exclude it.
.env
.env.*
!.env.example

# --- Local runtime data ------------------------------------------------------
# Raw payload blobs in dev (GM_BLOB_PATH); GCS in prod.
.data/

# --- Node / dashboard (arrives at S15.1) -------------------------------------
node_modules/
.next/
.turbo/

# --- Terraform (arrives at S26.1) --------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
!*.tfvars.example

# --- Editors and operating systems -------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/*
!.vscode/extensions.json

# --- Deliberately NOT ignored ------------------------------------------------
# uv.lock and requirements.lock.txt are committed. They are what makes a build
# reproducible, and a lockfile that only exists on one laptop is not a lockfile.
